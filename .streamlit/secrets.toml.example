# Chép thành .streamlit/secrets.toml khi chạy trên máy, hoặc dán nội dung này vào
# Streamlit Community Cloud → App settings → Secrets. KHÔNG commit secrets.toml.
MODEL_PROVIDER = "gemini"
MODEL_NAME = "gemini-3.1-flash-lite"
API_KEY = "dán key Gemini của nhóm vào đây"
DEMO_MAX_PER_SESSION = "15"
DEMO_MAX_PER_HOUR = "60"
